<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.milk.mapper.SetmealGoodsMapper">
    <insert id="insertBatch" parameterType="list">
        insert into setmeal_goods
        (setmeal_id,goods_id,name,price,copies)
        values
        <foreach collection="setmealGoods" item="sd" separator=",">
            (#{sd.setmealId},#{sd.goodsId},#{sd.name},#{sd.price},#{sd.copies})
        </foreach>
    </insert>


    <select id="getSetmealIdsByGoodsIds" resultType="java.lang.Long">
        select setmeal_id from setmeal_goods where goods_id in
        <foreach collection="goodsIds" item="dId" separator="," open="(" close=")">
            #{dId}
        </foreach>
    </select>

</mapper>